{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "../Eval/pointing/*.ts"
  ],
  "exclude": [
    "test/_probe*.ts"
  ]
}
